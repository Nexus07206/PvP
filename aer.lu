    PvPOff = Color3.fromRGB(255, 50, 80),

    SafeZoneOn = Color3.fromRGB(0, 235, 255),
    SafeZoneOff = Color3.fromRGB(255, 125, 30),

    Combat = Color3.fromRGB(255, 215, 0),

    -- Glow / outline
    Outline = Color3.fromRGB(5, 5, 10),
